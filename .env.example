# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MySQL 8.0 Configuration (optional in preview; falls back to local persistent store when unset)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=face_attendance_db

# Admin Authentication (optional override; if unset, first-run admin setup form claims initial admin)
ADMIN_EMAIL=
ADMIN_PASSCODE=

# Python Face Recognition Engine API Key (used by face_engine/recognize_attendance.py)
FACE_ENGINE_API_KEY=

